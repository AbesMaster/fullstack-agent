# ------------------------------------------------------------------
# FELICIA OS environment template. Copy to .env.local (dev) — NEVER commit real values.
# Every integration is optional: without credentials the system uses clearly
# labelled mock providers and reports the integration as "not connected".
# ------------------------------------------------------------------
APP_ENV=development            # development | staging | production
# The site's public address. Every link, email and search listing uses it, so it can live on any domain.
APP_URL=http://localhost:3000

# Database: leave empty in development to use embedded PGlite (.data/pglite).
# Staging/production: managed PostgreSQL 15+ with the pgvector extension.
DATABASE_URL=

# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64:  openssl rand -base64 32   (encrypts client intake forms — back it up securely!)
DATA_ENCRYPTION_KEY=
# Shared secret for the scheduler calling POST /api/cron/drain
CRON_SECRET=

# Anthropic (agent drafting + website assistant). Fast = routine, Standard = client-facing content.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_STANDARD=claude-opus-5-5

# Stripe (use TEST keys sk_test_… until launch is approved)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# HubSpot private app token (scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write)
HUBSPOT_ACCESS_TOKEN=

# Google Calendar via service account (share the calendar with the service account email)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Zoom Server-to-Server OAuth app (Zoom App Marketplace → Develop → Build App → Server-to-Server OAuth).
# Scopes: meeting:write:meeting:admin, meeting:update:meeting:admin, meeting:delete:meeting:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=me              # or Felicia's Zoom email, if the app belongs to a different admin user

# Transactional email (Resend)
EMAIL_PROVIDER_API_KEY=
# Must be on the same domain as APP_URL (the launch check enforces this).
EMAIL_FROM="Felicia Stefan <hello@feliciastefan.com>"

# JARVIS OS parent-system connector (leave empty until its API spec is supplied)
JARVIS_BASE_URL=
JARVIS_API_TOKEN=

# Website analytics are built in (cookieless, first-party). No account or key needed.
